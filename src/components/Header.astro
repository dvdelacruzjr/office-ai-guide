---
import { siteConfig } from '../config/site';
const path = Astro.url.pathname;

function isActive(href: string) {
  const target = href.replace(/\/$/, '') || '/';
  const current = path.replace(/\/$/, '') || '/';
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="sticky top-0 z-40 border-b border-line/80 bg-paper/85 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="group flex items-center gap-2 no-underline">
      <span
        class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-accent to-claude text-xs font-bold tracking-tight text-white shadow-sm"
        aria-hidden="true"
      >
        OAG
      </span>
      <span>
        <span class="block text-sm font-semibold text-ink group-hover:text-accent">{siteConfig.name}</span>
        <span class="hidden text-xs text-ink-muted sm:block">Office-ready AI playbooks</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        siteConfig.nav.map((item) => {
          const active = isActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'rounded-full px-3 py-2 text-sm font-medium no-underline transition',
                active ? 'bg-paper-2 text-ink' : 'text-ink-muted hover:bg-paper-2 hover:text-ink',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="flex items-center gap-2">
      <a href="/prompts/" class="btn-secondary hidden md:inline-flex">Prompt library</a>
      <a href="/guides/" class="btn-primary hidden md:inline-flex">Browse guides</a>

      <details class="relative md:hidden">
        <summary
          class="btn-secondary cursor-pointer list-none marker:content-none [&::-webkit-details-marker]:hidden"
        >
          Menu
        </summary>
        <nav
          class="absolute right-0 z-50 mt-2 w-56 rounded-2xl border border-line bg-card p-2 shadow-lg"
          aria-label="Mobile"
        >
          {
            siteConfig.nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'block rounded-xl px-3 py-2.5 text-sm font-medium no-underline',
                  isActive(item.href) ? 'bg-paper-2 text-ink' : 'text-ink hover:bg-paper-2',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>
