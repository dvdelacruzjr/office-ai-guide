---
import { siteConfig } from '../config/site';
const { newsletter } = siteConfig;
---

<section id="newsletter" class="card overflow-hidden">
  <div class="grid gap-0 md:grid-cols-[1.2fr_1fr]">
    <div class="p-8 sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Weekly playbook</p>
      <h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-ink">{newsletter.heading}</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{newsletter.blurb}</p>
    </div>
    <div class="border-t border-line bg-paper-2 p-8 sm:p-10 md:border-l md:border-t-0">
      <form
        id="newsletter-form"
        action={newsletter.formAction}
        method={newsletter.formMethod}
        class="space-y-3"
        data-newsletter
      >
        <label class="block text-sm font-medium text-ink" for="email">Work email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          autocomplete="email"
          placeholder={newsletter.placeholder}
          class="w-full rounded-xl border border-line bg-card px-4 py-3 text-sm text-ink outline-none ring-accent focus:ring-2"
        />
        <button type="submit" class="btn-primary w-full">{newsletter.buttonLabel}</button>
        <p class="text-xs text-ink-muted">
          Demo form: wire <code>formAction</code> in <code>src/config/site.ts</code> to your email provider.
        </p>
        <p id="newsletter-status" class="hidden text-sm font-medium text-accent" role="status"></p>
      </form>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const status = document.getElementById('newsletter-status');
  form?.addEventListener('submit', (event) => {
    const action = form.getAttribute('action') || '';
    if (action.startsWith('#') || action === '' || action.includes('example.com')) {
      event.preventDefault();
      if (status) {
        status.textContent = 'You’re on the list. Watch for a playbook next week.';
        status.classList.remove('hidden');
      }
      form.reset();
    }
  });
</script>
