---
import { siteConfig } from '../config/site';
const { newsletter } = siteConfig;
---

<section id="newsletter" class="card overflow-hidden">
  <div class="grid gap-0 md:grid-cols-[1.2fr_1fr]">
    <div class="p-8 sm:p-10">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Weekly playbook</p>
      <h2 class="font-display mt-3 text-3xl font-semibold tracking-tight text-ink">{newsletter.heading}</h2>
      <p class="mt-3 max-w-xl text-sm leading-relaxed text-ink-muted">{newsletter.blurb}</p>
    </div>
    <div class="border-t border-line bg-paper-2 p-8 sm:p-10 md:border-l md:border-t-0">
      <p class="text-sm font-semibold text-ink">No email list yet</p>
      <p class="mt-2 text-sm leading-relaxed text-ink-muted">
        This is not a signup form. We are not collecting addresses, and nothing here is sent anywhere.
      </p>
      <a href="/rss.xml" class="btn-primary mt-5">Follow guides via RSS</a>
    </div>
  </div>
</section>
