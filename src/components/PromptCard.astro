---
import type { PromptItem } from '../data/prompts';
import { highlightPlaceholders } from '../data/prompts';
import ToolBadge from './ToolBadge.astro';

interface Props {
  prompt: PromptItem;
}

const { prompt } = Astro.props;
const highlighted = highlightPlaceholders(prompt.prompt);
---

<article class="card hover-card flex h-full flex-col p-5" data-prompt-card data-tool={prompt.tool} data-department={prompt.department} data-title={prompt.title.toLowerCase()} data-summary={prompt.summary.toLowerCase()}>
  <div class="flex flex-wrap items-center gap-2">
    <ToolBadge tool={prompt.tool} />
    <span class="chip">
      {prompt.department}
    </span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-ink">{prompt.title}</h3>
  <p class="mt-2 text-sm text-ink-muted">{prompt.summary}</p>
  <pre class="mt-4 max-h-72 flex-1 overflow-auto whitespace-pre-wrap rounded-xl border border-line bg-[var(--code-bg)] p-4 font-mono text-[12.5px] leading-relaxed text-stone-100" set:html={highlighted}></pre>
  <div class="mt-4 flex justify-end">
    <button
      type="button"
      class="btn-secondary"
      data-copy={prompt.prompt}
      data-label="Copy prompt"
    >
      Copy prompt
    </button>
  </div>
</article>
