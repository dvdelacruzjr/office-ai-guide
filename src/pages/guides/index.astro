---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from '../../components/GuideCard.astro';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);

const tools = ['Claude', 'Grok Bot', 'ChatGPT', 'Multi-Tool'] as const;
const departments = [
  'Operations',
  'Sales & Client Comms',
  'Finance & Admin',
  'Leadership & Strategy',
  'HR & People',
  'Marketing',
] as const;
---

<BaseLayout
  title="Guides & Playbooks"
  description="Filterable how-to guides for Claude, Grok Bot, and ChatGPT—built for business owners and office teams."
>
  <section class="hero-bg border-b border-line">
    <div class="container-page py-14">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-accent">Guides & playbooks</p>
      <h1 class="font-display mt-3 text-4xl font-semibold tracking-tight text-ink sm:text-5xl">Practical AI workflows for office work</h1>
      <p class="mt-4 max-w-2xl text-ink-muted">
        Filter by tool or department. Every guide includes copyable prompts and a Team Safety & Privacy Note.
      </p>
    </div>
  </section>

  <section class="container-page py-10">
    <form id="guide-filters" class="card grid gap-4 p-5 md:grid-cols-[1.2fr_1fr_1fr_auto]" role="search">
      <div>
        <label for="q" class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Search</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="SOPs, inbox, proposals…"
          class="mt-2 w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm outline-none ring-accent focus:ring-2"
        />
      </div>
      <div>
        <label for="tool" class="text-xs font-semibold uppercase tracking-wide text-ink-muted">AI tool</label>
        <select id="tool" name="tool" class="mt-2 w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm outline-none ring-accent focus:ring-2">
          <option value="">All tools</option>
          {tools.map((tool) => <option value={tool}>{tool}</option>)}
        </select>
      </div>
      <div>
        <label for="department" class="text-xs font-semibold uppercase tracking-wide text-ink-muted">Department</label>
        <select id="department" name="department" class="mt-2 w-full rounded-xl border border-line bg-paper px-3 py-2.5 text-sm outline-none ring-accent focus:ring-2">
          <option value="">All departments</option>
          {departments.map((dept) => <option value={dept}>{dept}</option>)}
        </select>
      </div>
      <div class="flex items-end">
        <button type="reset" class="btn-secondary w-full">Reset</button>
      </div>
    </form>

    <p id="guide-count" class="mt-6 text-sm text-ink-muted">{guides.length} guides</p>

    <div id="guide-grid" class="mt-4 grid gap-5 md:grid-cols-2">
      {
        guides.map((guide) => (
          <div
            data-guide-item
            data-tool={guide.data.tool}
            data-department={guide.data.department}
            data-search={`${guide.data.title} ${guide.data.summary}`.toLowerCase()}
          >
            <GuideCard guide={guide} />
          </div>
        ))
      }
    </div>
    <p id="guide-empty" class="mt-10 hidden rounded-2xl border border-dashed border-line bg-paper-2 p-8 text-center text-ink-muted">
      No guides match those filters. Try another tool or clear search.
    </p>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const form = document.getElementById('guide-filters') as HTMLFormElement | null;
  const q = document.getElementById('q') as HTMLInputElement | null;
  const tool = document.getElementById('tool') as HTMLSelectElement | null;
  const department = document.getElementById('department') as HTMLSelectElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-guide-item]'));
  const count = document.getElementById('guide-count');
  const empty = document.getElementById('guide-empty');

  if (q && params.get('q')) q.value = params.get('q') || '';
  if (tool && params.get('tool')) tool.value = params.get('tool') || '';
  if (department && params.get('department')) department.value = params.get('department') || '';

  function applyFilters() {
    const query = (q?.value || '').trim().toLowerCase();
    const toolValue = tool?.value || '';
    const deptValue = department?.value || '';
    let visible = 0;

    items.forEach((item) => {
      const matchesQuery = !query || (item.dataset.search || '').includes(query);
      const matchesTool = !toolValue || item.dataset.tool === toolValue;
      const matchesDept = !deptValue || item.dataset.department === deptValue;
      const show = matchesQuery && matchesTool && matchesDept;
      item.classList.toggle('hidden', !show);
      if (show) visible += 1;
    });

    if (count) count.textContent = `${visible} guide${visible === 1 ? '' : 's'}`;
    empty?.classList.toggle('hidden', visible !== 0);

    const next = new URLSearchParams();
    if (query) next.set('q', query);
    if (toolValue) next.set('tool', toolValue);
    if (deptValue) next.set('department', deptValue);
    const qs = next.toString();
    window.history.replaceState({}, '', qs ? `?${qs}` : window.location.pathname);
  }

  form?.addEventListener('input', applyFilters);
  form?.addEventListener('change', applyFilters);
  form?.addEventListener('reset', () => {
    window.setTimeout(applyFilters, 0);
  });
  applyFilters();
</script>
